{
    "name": "saksham/laravel-maintenance-signal",
    "description": "Adds a configurable HTTP header to Laravel maintenance mode responses.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Saksham\\MaintenanceSignal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saksham\\MaintenanceSignal\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saksham\\MaintenanceSignal\\MaintenanceSignalServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
